node_modules/
dist/
lib/
*.log
.DS_Store

# 本地开发/取证产物（公开镜像不发布）
scripts/.probe/

# 发布仓库独立安装时的本地 store（pnpm-lock.yaml/pnpm-workspace.yaml 是镜像专属文件，
# 见 scripts/sync-to-github.sh 文件头「两类例外」）
.pnpm-store/

# 多会话隔离用的 git worktree（每个需求一个；2026-09-30 事故后约定：并发会话不得共用工作树）
.worktrees/

# 运行时台账与本地取证产物：.dsh-data/dsh-reqboard.json 是**活台账**（含会话 id 与本机路径），
# 且随每次需求操作变动；baseline-*/pre-fix/post-fix 是本地比对原始输出。只本机用，不发布。
.dsh-data/

# skill 资产里 Python 脚本的字节码缓存（随机器与解释器版本变）
__pycache__/
*.pyc
