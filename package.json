{
  "name": "dsh-pmboard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "pm 插件（仓库根 = workspace 根；插件主体在 pm/，其余 19 个是它的组件包）",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "boundary:check": "tsx scripts/package-boundary-check.mts",
    "kb:build": "tsx scripts/kb-build.mts --write",
    "kb:check": "tsx scripts/kb-build.mts --check && tsx scripts/kb-conventions-sync.mts --check && tsx scripts/kb-probe.mts",
    "kb:conventions": "tsx scripts/kb-conventions-sync.mts --check",
    "kb:probe": "tsx scripts/kb-probe.mts",
    "prompts:check": "node scripts/inline-prompt-fragments.mjs && node scripts/check-prompt-fragments.mjs && tsx scripts/prompt-path-probe.mts",
    "prompts:verify": "node scripts/check-prompt-fragments.mjs",
    "templates:check": "tsx scripts/template-gate-probe.mts && tsx scripts/doc-section-parity.mts",
    "templates:probe": "tsx scripts/template-gate-probe.mts --specimen && tsx scripts/doc-section-parity.mts --specimen",
    "baseline:check": "tsx scripts/test-baseline.mts --check",
    "baseline:refresh": "tsx scripts/test-baseline.mts --refresh",
    "commit:check": "tsx scripts/commit-check.mts",
    "cost:report": "tsx scripts/token-cost-report.mts",
    "verify:client": "node scripts/verify-client-build.mjs",
    "build": "pnpm --filter dsh-pmboard build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^20.11.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  }
}