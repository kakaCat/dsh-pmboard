          <mxGeometry x="660" y="884" width="560" height="70" as="geometry" />
        </mxCell>

        <mxCell id="r_head" value="目标 · 8 件（7 条收编线 + submit 原样保留；每轮只重发 8 个 schema）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="240" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="reqboard_status —— 只读单一入口&#10;绑定 / 需求 / goal 节（相位·陈述·阻塞原因·id+revision）/ stage 节（表·进度·ready_to_close）/ run / 覆盖度 / 卡树" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontColor=#0D47A1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="310" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="reqboard_goal —— op=create·update·stage；action=pause·resume·block·complete·stage_done（resume / stage_done 仍真人专属，per-op 授权表原样搬）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;fontSize=12;fontColor=#1B5E20;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="392" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="reqboard_capture —— 无参 = 弹框立项；带值 = 直接建（原子，不再两段式）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontColor=#0D47A1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="474" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="reqboard_submit —— 产物 6 kind（已收敛，只做登记 + 挂门）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontColor=#0D47A1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="556" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="reqboard_confirm —— op=ask·sheet；ticket 取回执（两条建门通道的发起唯一性要先定）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=2;fontSize=12;fontColor=#E65100;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="638" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="reqboard_task —— op=plan·move·report·tree·amend·run（amend 的 5 个 op 降为参数）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontColor=#0D47A1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="720" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="reqboard_env —— op=window·bind·handoff·kb·skill" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontColor=#0D47A1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="802" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r8" value="（第 8 位 = move 的归属：并入 goal(op=advance) 或撤 —— 待定夺）" style="rounded=1;arcSize=8;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=2;fontSize=12;fontColor=#B71C1C;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="884" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="三处不能省（并了会坏）&#10;1. per-op 授权：resume / stage_done 真人专属；complete / block 要 goal-round 三元组精确匹配 —— 逻辑原样搬，不许因「一个工具」放宽&#10;2. 两条弹框通道的发起唯一性：产物门（submit.auto_confirm）vs 阶段门（驱动 askStageDone）&#10;3. 驱动零 I/O 不动：工具怎么并，factsOf 的窄投影都不变" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=2;fontSize=12;fontColor=#B71C1C;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1080" width="600" height="280" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="迁移三批（一批一 revert，各自可回滚）&#10;批 1：goal 面 6 → 2（status 吸收两个只读节 + goal 收编 stage 两件）+ 驱动 seed 阶段表（顺手解 ask-stage-done 死锁）&#10;批 2：task 面 5 → 1（decompose / task_run 收进 op）&#10;批 3：confirm 3 → 1 · capture 2 → 1 · env 5 → 1&#10;每批验收口径：逐批差分新增红 = 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontColor=#0D47A1;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="1080" width="600" height="280" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="代价（如实说）&#10;· 6 处口径同改：registry / 磁盘目录 / apply 注册名 / README / package.json description（+ 注入片段重生成、错误码台账刷新）&#10;· 按工具名的用例要跟着改；旧名调用变 unknown tool = 有意行为断，需人授权&#10;· 并簇会把描述变长：净省的是「槽位重发量」，不是「描述字数」" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1080" width="560" height="280" as="geometry" />
        </mxCell>

