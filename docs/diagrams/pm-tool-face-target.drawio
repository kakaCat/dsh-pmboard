        <mxCell id="title" value="按 dsh goal 形态收敛工具面：25 → 8（省 17 个常驻 schema）" style="text;html=1;fontSize=22;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="920" height="40" as="geometry" />
        </mxCell>

        <mxCell id="z_host" value="对照：宿主（DSH 原生）goal 面 = 3 件 + 四条原则" style="rounded=1;fillColor=#FAFAFA;strokeColor=#E0E0E0;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#757575;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1840" height="120" as="geometry" />
        </mxCell>
        <mxCell id="host3" value="create_goal(objective) · get_goal()（无参） · update_goal(id, revision, action, …)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pr4" value="① 一桩事一槽位（读 / 建 / 改）　② 参数从上下文取（get_goal 一个参数都不要）　③ 动作靠 action 复用 + CAS(id+revision)　④ 流程交驱动，工具只说必须说的" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="1320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="l_head" value="现在 · 25 件（tool-pm 19 + tool-pm-goal 6）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#424242;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l_goal" value="goal 面 6 件&#10;goal_get · goal_create · goal_update&#10;stage_goal_get · stage_goal_create · stage_goal_done" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;fontSize=12;fontColor=#1B5E20;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="l_tab" value="台账面 19 件（5 组）&#10;立项与自查（3）：capture · create · status&#10;阶段推进与人工门（5）：submit · ask_confirm · move · accept_sheet · clear_pause&#10;拆分与任务（5）：decompose · task_move · task_report · task_tree · task_amend&#10;自动实施链（1）：task_run&#10;协作与环境（5）：open_window · bind · handoff · kb · skill_install" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="560" height="260" as="geometry" />
        </mxCell>
        <mxCell id="l_pre" value="本仓已有先例：submit 收 6 个 kind · task_amend 收 5 个 op · status 收 run 节 —— op 簇是既定手法，只是没推到 goal / task 面" style="rounded=1;arcSize=8;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontColor=#0D47A1;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="560" height="100" as="geometry" />
        </mxCell>

