        <mxCell id="e_main" value="按宿主形态收编：只读合并 + op 簇" style="endArrow=classic;strokeWidth=3;strokeColor=#1976D2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontStyle=1;fontColor=#0D47A1;" edge="1" source="l_head" target="r_head" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="265" /><mxPoint x="1160" y="265" /></Array></mxGeometry></mxCell>
