          <mxGeometry x="660" y="638" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="decompose + task_move + task_report + task_tree + task_amend + task_run → task(op=plan·move·report·tree·amend·run)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=2;fontSize=12;fontColor=#E65100;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="720" width="560" height="70" as="geometry" />
