        <mxCell id="e_c1c2" value="建好即 drive" style="endArrow=classic;strokeWidth=2;strokeColor=#1565C0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#0D47A1;" edge="1" source="c1" target="c2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
