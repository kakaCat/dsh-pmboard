<mxfile host="draw.io" agent="drawskills" version="24.7.17" type="device">
  <diagram id="pm-tool-face-vs-goal" name="工具面 × goal 口径">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="工具面 × goal 口径：哪些该走 goal 工具（tool-pm 19 件 + tool-pm-goal 6 件）" style="text;html=1;fontSize=22;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="880" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ev" value="触发：reqboard/requirement-moved · agent idle · 心跳 wakeTick · agent/inbox/* · session/event turn/end" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="drv" value="pm-goal-round-driver（唯一驱动点）&#10;factsOf → decideGoalRound（八步闸，纯函数）→ actOnDecision（六态）&#10;零 I/O：只决策，不写台账、不写产物" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="580" height="90" as="geometry" />
        </mxCell>
        <mxCell id="out" value="出口六态：drive 起轮 · create-goal 建目标 · ask-stage-done 请人判 · block-goal 落盘 · wait-human 等人 · hold 停手" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;" vertex="1" parent="1">
          <mxGeometry x="1200" y="100" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="zg" value="goal 面（tool-pm-goal，6 件）—— 驱动判据的唯一来源：回答「这段工作 / 这个阶段成没成」" style="rounded=1;fillColor=#FAFAFA;strokeColor=#E0E0E0;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#757575;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="760" height="540" as="geometry" />
        </mxCell>
        <mxCell id="zl" value="台账面（tool-pm，19 件）—— 驱动零 I/O 不碰：回答「跑的时候写什么」" style="rounded=1;fillColor=#FAFAFA;strokeColor=#E0E0E0;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#757575;" vertex="1" parent="1">
          <mxGeometry x="880" y="260" width="780" height="540" as="geometry" />
        </mxCell>

        <mxCell id="g1" value="reqboard_goal_get &#10;读当前 goal：相位 / 陈述 / 阻塞原因 / 改相位要用的 id+revision" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;fontSize=12;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="90" y="320" width="700" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="reqboard_goal_create &#10;为当前这段工作建 goal（objective 复用任务卡的 acceptance，不另编一份）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;fontSize=12;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="90" y="415" width="700" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="reqboard_goal_update &#10;相位迁移：pause / resume（真人专属）/ block（原因 + 回合阈值）/ complete；落终态后自主回合注入收尾指令" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;fontSize=12;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="90" y="510" width="700" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="reqboard_stage_goal_get / create / done &#10;阶段目标表：get 读表 + 能否收口 · create 登记（stage + statement + done_criteria）· done 落章（真人专属）&#10;全达成 ⇒ ready_to_close" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="90" y="605" width="700" height="100" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="立项与自查（3）：reqboard_capture · reqboard_create · reqboard_status（含 run 节）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="320" width="740" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="阶段推进与人工门（5）：reqboard_submit（产物 + auto_confirm）· reqboard_ask_confirm（含 ticket 取回执）· reqboard_move · reqboard_accept_sheet · reqboard_clear_pause" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="405" width="740" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="拆分与任务（5）：reqboard_decompose · reqboard_task_move · reqboard_task_report · reqboard_task_tree · reqboard_task_amend（op=refs/adopt/chain/archive/interruption）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="490" width="740" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="自动实施链（1）：reqboard_task_run（起链 + 写 autoRun）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="575" width="740" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="协作与环境（5）：reqboard_open_window · reqboard_bind · reqboard_handoff · reqboard_kb · reqboard_skill_install" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="660" width="740" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l6" value="但：写台账 = 必回驱动 —— 任何一条写路径落库后，存储订阅桥发 reqboard/requirement-moved → 驱动 requestDrive 下一拍（「都走驱动」的回路就在这里）" style="rounded=1;arcSize=10;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontColor=#0D47A1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="745" width="740" height="45" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="T1 · 缺口（必修）：阶段表没有第二个写入口&#10;全仓 setStageGoals 只有 reqboard_stage_goal_create 一处调用；而 pm-core 的注入片段里 reqboard_goal* 出现 0 次。&#10;⇒ 阶段表没人登记时 readyToClose = false（fold.ts:403 要求表非空且全 done）⇒ 驱动的 ask-stage-done 永不触发 ⇒ 只能跑到 round-limit 落盘 block。&#10;修法：① 驱动建首个 goal 时按 ALL_STAGE_KEYS seed 阶段表；② 阶段分片写死「开工先登记本阶段目标」。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=2;fontSize=12;fontColor=#B71C1C;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="830" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="T2 · 可收敛（省 2 个常驻 schema）：读面重叠&#10;reqboard_status（含 run 节）· reqboard_goal_get · reqboard_stage_goal_get 查同一份事实。&#10;按 tool-face-inventory §三.3 的既有手法，把 goal / stage 只读节并进 status。&#10;（工具 schema 每轮重发，省槽位 = 省 token + 少一个选错面）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=2;fontSize=12;fontColor=#E65100;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="830" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="D3 · 待定夺：弹框两条通道&#10;产物门由 reqboard_submit 的 auto_confirm 现场建门；阶段门由驱动 askStageDone（stage-prompt：冷却 5min / 上限 2 次）建门。&#10;两条都写「人工门在途」，都靠人落章。若「都走驱动」，阶段门的发起唯一性该收紧（谁建门、谁能重弹）。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=2;fontSize=12;fontColor=#424242;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1180" y="830" width="520" height="230" as="geometry" />
        </mxCell>

        <mxCell id="e_ev" style="endArrow=classic;strokeWidth=2;strokeColor=#78909C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;" edge="1" source="ev" target="drv" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_out" style="endArrow=classic;strokeWidth=2;strokeColor=#78909C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;" edge="1" source="drv" target="out" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_g1" value="读相位" style="endArrow=classic;strokeWidth=2;strokeColor=#43A047;exitX=0.3;exitY=0;entryX=0.25;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#1B5E20;" edge="1" source="g1" target="drv" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="225" /><mxPoint x="705" y="225" /></Array></mxGeometry></mxCell>
        <mxCell id="e_g2" value="create-goal" style="endArrow=classic;strokeWidth=2;strokeColor=#43A047;exitX=1;exitY=0.5;entryX=0.35;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#1B5E20;" edge="1" source="g2" target="drv" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="836" y="455" /><mxPoint x="836" y="235" /><mxPoint x="763" y="235" /></Array></mxGeometry></mxCell>
        <mxCell id="e_g3" value="相位变更" style="endArrow=classic;strokeWidth=2;strokeColor=#43A047;exitX=1;exitY=0.5;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#1B5E20;" edge="1" source="g3" target="drv" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="852" y="550" /><mxPoint x="852" y="245" /></Array></mxGeometry></mxCell>
        <mxCell id="e_g4" value="readyToClose" style="endArrow=classic;strokeWidth=3;strokeColor=#43A047;exitX=1;exitY=0.5;entryX=0.65;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontStyle=1;fontColor=#1B5E20;" edge="1" source="g4" target="drv" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="868" y="655" /><mxPoint x="868" y="255" /><mxPoint x="937" y="255" /></Array><mxPoint x="-150" y="0" as="offset" /></mxGeometry></mxCell>

        <mxCell id="e_loop" value="写台账 → requirement-moved → 回到驱动拍（每条写路径都闭环）" style="endArrow=classic;strokeWidth=2;strokeColor=#1976D2;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#0D47A1;" edge="1" source="l1" target="drv" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_t1" value="唯一写入口在这 6 件里" style="endArrow=classic;strokeWidth=2;strokeColor=#E53935;dashed=1;exitX=0.35;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#B71C1C;" edge="1" source="g4" target="t1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_t2a" value="" style="endArrow=classic;strokeWidth=2;strokeColor=#FFA000;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#E65100;" edge="1" source="l1" target="t2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1666" y="355" /><mxPoint x="1666" y="830" /></Array></mxGeometry></mxCell>
        <mxCell id="e_t2b" value="三面查同一份事实" style="endArrow=classic;strokeWidth=2;strokeColor=#FFA000;dashed=1;exitX=0;exitY=0.3;entryX=0.04;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#E65100;" edge="1" source="g1" target="t2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="74" y="344" /><mxPoint x="74" y="812" /><mxPoint x="642" y="812" /></Array><mxPoint x="80" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e_t3" value="两条建门通道" style="endArrow=classic;strokeWidth=2;strokeColor=#9E9E9E;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#616161;" edge="1" source="l2" target="t3" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="440" /><mxPoint x="1690" y="880" /></Array></mxGeometry></mxCell>
