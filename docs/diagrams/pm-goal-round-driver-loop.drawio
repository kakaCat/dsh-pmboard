        <mxCell id="e_s4" style="endArrow=classic;strokeWidth=2;strokeColor=#D32F2F;exitX=0.6;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;" edge="1" source="d34" target="r_block" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s5" style="endArrow=classic;strokeWidth=2;strokeColor=#C2185B;exitX=0.75;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;" edge="1" source="d34" target="r_wait" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s6" style="endArrow=classic;strokeWidth=2;strokeColor=#9E9E9E;exitX=0.9;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;" edge="1" source="d34" target="r_hold" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_o1" value="实做" style="endArrow=classic;strokeWidth=2;strokeColor=#00897B;exitX=0.5;exitY=1;entryX=0.4;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#004D40;" edge="1" source="r_drive" target="b1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_o2" value="建好即下一拍 drive" style="endArrow=classic;strokeWidth=2;strokeColor=#1565C0;exitX=0.5;exitY=1;entryX=0.8;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;fontColor=#0D47A1;" edge="1" source="r_create" target="b1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
