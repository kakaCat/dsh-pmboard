{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "tests/*": ["./tests/*"],
      "src/*": ["./src/*"],
      "scripts/*": ["./scripts/*"],
      "react-dom/server": [
        "./tests/stubs/react-dom-server.ts"
      ],
      "@deepseek-ai/dsh-session": [
        "./tests/stubs/dsh-session.d.ts"
      ],
      "pmboard-common": [
        "./packages/pmboard-common/src/index.ts"
      ],
      "pmboard-common/*": [
        "./packages/pmboard-common/src/*"
      ],
      "reqboard-rtm": [
        "./packages/reqboard-rtm/src/index.ts"
      ],
      "reqboard-rtm/*": [
        "./packages/reqboard-rtm/src/*"
      ],
      "pmboard-core": [
        "./packages/pmboard-core/src/index.ts"
      ],
      "pmboard-core/*": [
        "./packages/pmboard-core/src/*"
      ],
      "pmboard-type-kit": [
        "./packages/pmboard-type-kit/src/index.ts"
      ],
      "pmboard-type-kit/*": [
        "./packages/pmboard-type-kit/src/*"
      ],
      "pmboard-type-feature": [
        "./packages/pmboard-type-feature/src/index.ts"
      ],
      "pmboard-type-feature/*": [
        "./packages/pmboard-type-feature/src/*"
      ],
      "pmboard-type-bug": [
        "./packages/pmboard-type-bug/src/index.ts"
      ],
      "pmboard-type-bug/*": [
        "./packages/pmboard-type-bug/src/*"
      ],
      "pmboard-type-doc": [
        "./packages/pmboard-type-doc/src/index.ts"
      ],
      "pmboard-type-doc/*": [
        "./packages/pmboard-type-doc/src/*"
      ],
      "pmboard-type-refactor": [
        "./packages/pmboard-type-refactor/src/index.ts"
      ],
      "pmboard-type-refactor/*": [
        "./packages/pmboard-type-refactor/src/*"
      ],
      "pmboard-type-spike": [
        "./packages/pmboard-type-spike/src/index.ts"
      ],
      "pmboard-type-spike/*": [
        "./packages/pmboard-type-spike/src/*"
      ],
      "pmboard-type-chore": [
        "./packages/pmboard-type-chore/src/index.ts"
      ],
      "pmboard-type-chore/*": [
        "./packages/pmboard-type-chore/src/*"
      ],
      "tool-pmboard": [
        "./packages/tool-pmboard/src/index.ts"
      ],
      "tool-pmboard/*": [
        "./packages/tool-pmboard/src/*"
      ],
      "pmboard-round-driver": [
        "./packages/pmboard-round-driver/src/index.ts"
      ],
      "pmboard-round-driver/*": [
        "./packages/pmboard-round-driver/src/*"
      ],
      "pmboard-workflow": [
        "./packages/pmboard-workflow/src/index.ts"
      ],
      "pmboard-workflow/*": [
        "./packages/pmboard-workflow/src/*"
      ],
      "pmboard-client": [
        "./packages/pmboard-client/src/index.ts"
      ],
      "pmboard-client/*": [
        "./packages/pmboard-client/src/*"
      ],
      "command-pmboard": [
        "./packages/command-pmboard/src/index.ts"
      ],
      "command-pmboard/*": [
        "./packages/command-pmboard/src/*"
      ],
      "pmboard-templates": [
        "./packages/pmboard-templates"
      ],
      "pmboard-skills": [
        "./packages/pmboard-skills"
      ],
      "pmboard-eval-suite": [
        "./packages/pmboard-eval-suite"
      ],
      "pmboard-scripts": [
        "./packages/pmboard-scripts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib"
  ]
}
