{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "tests/*": ["./tests/*"],
      "src/*": ["./pm/src/*"],
      "scripts/*": ["./scripts/*"],
      "react-dom/server": [
        "./tests/stubs/react-dom-server.ts"
      ],
      "@deepseek-ai/dsh-session": [
        "./tests/stubs/dsh-session.d.ts"
      ],
      "pm-common": [
        "./pm-common/src/index.ts"
      ],
      "pm-common/*": [
        "./pm-common/src/*"
      ],
      "reqboard-rtm": [
        "./reqboard-rtm/src/index.ts"
      ],
      "reqboard-rtm/*": [
        "./reqboard-rtm/src/*"
      ],
      "pm-core": [
        "./pm-core/src/index.ts"
      ],
      "pm-core/*": [
        "./pm-core/src/*"
      ],
      "pm-category-kit": [
        "./category/pm-category-kit/src/index.ts"
      ],
      "pm-category-kit/*": [
        "./category/pm-category-kit/src/*"
      ],
      "pm-category-feature": [
        "./category/pm-category-feature/src/index.ts"
      ],
      "pm-category-feature/*": [
        "./category/pm-category-feature/src/*"
      ],
      "pm-category-bug": [
        "./category/pm-category-bug/src/index.ts"
      ],
      "pm-category-bug/*": [
        "./category/pm-category-bug/src/*"
      ],
      "pm-category-doc": [
        "./category/pm-category-doc/src/index.ts"
      ],
      "pm-category-doc/*": [
        "./category/pm-category-doc/src/*"
      ],
      "pm-category-refactor": [
        "./category/pm-category-refactor/src/index.ts"
      ],
      "pm-category-refactor/*": [
        "./category/pm-category-refactor/src/*"
      ],
      "pm-category-spike": [
        "./category/pm-category-spike/src/index.ts"
      ],
      "pm-category-spike/*": [
        "./category/pm-category-spike/src/*"
      ],
      "pm-category-chore": [
        "./category/pm-category-chore/src/index.ts"
      ],
      "pm-category-chore/*": [
        "./category/pm-category-chore/src/*"
      ],
      "tool-pm-goal": [
        "./goal/tool-pm-goal/src/index.ts"
      ],
      "tool-pm-goal/*": [
        "./goal/tool-pm-goal/src/*"
      ],
      "tool-pm": [
        "./tool-pm/src/index.ts"
      ],
      "tool-pm/*": [
        "./tool-pm/src/*"
      ],
      "pm-goal-round-driver": [
        "./goal/pm-goal-round-driver/src/index.ts"
      ],
      "pm-goal-round-driver/*": [
        "./goal/pm-goal-round-driver/src/*"
      ],
      "pm-goal": [
        "./goal/pm-goal/src/index.ts"
      ],
      "pm-goal/*": [
        "./goal/pm-goal/src/*"
      ],
      "pm-round-driver": [
        "./pm-round-driver/src/index.ts"
      ],
      "pm-round-driver/*": [
        "./pm-round-driver/src/*"
      ],
      "pm-workflow": [
        "./pm-workflow/src/index.ts"
      ],
      "pm-workflow/*": [
        "./pm-workflow/src/*"
      ],
      "pm-client": [
        "./pm-client/src/index.ts"
      ],
      "pm-client/*": [
        "./pm-client/src/*"
      ],
      "command-pm": [
        "./command-pm/src/index.ts"
      ],
      "command-pm/*": [
        "./command-pm/src/*"
      ],
      "pm-templates": [
        "./pm-templates"
      ],
      "pm-skills": [
        "./pm-skills"
      ],
      "pm-eval-suite": [
        "./pm-eval-suite"
      ],
      "pm-scripts": [
        "./pm-scripts"
      ]
    }
  },
  "include": ["pm/src/**/*.ts","pm-*/src/**/*.ts","pm-*/tests/**/*.ts","category/*/src/**/*.ts","category/*/tests/**/*.ts","goal/*/src/**/*.ts","goal/*/tests/**/*.ts","tool-pm/src/**/*.ts","tool-pm/tests/**/*.ts","command-pm/src/**/*.ts","command-pm/tests/**/*.ts","reqboard-rtm/src/**/*.ts","reqboard-rtm/tests/**/*.ts","tests/**/*.ts","scripts/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "lib"
  ]
}
