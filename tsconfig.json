{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "tests/*": ["./tests/*"],
      "src/*": ["./src/*"],
      "scripts/*": ["./scripts/*"],
      "react-dom/server": [
        "./tests/stubs/react-dom-server.ts"
      ],
      "@deepseek-ai/dsh-session": [
        "./tests/stubs/dsh-session.d.ts"
      ],
      "pm-common": [
        "./pm-common/src/index.ts"
      ],
      "pm-common/*": [
        "./pm-common/src/*"
      ],
      "reqboard-rtm": [
        "./reqboard-rtm/src/index.ts"
      ],
      "reqboard-rtm/*": [
        "./reqboard-rtm/src/*"
      ],
      "pm-core": [
        "./pm-core/src/index.ts"
      ],
      "pm-core/*": [
        "./pm-core/src/*"
      ],
      "pm-type-kit": [
        "./pm-type-kit/src/index.ts"
      ],
      "pm-type-kit/*": [
        "./pm-type-kit/src/*"
      ],
      "pm-type-feature": [
        "./pm-type-feature/src/index.ts"
      ],
      "pm-type-feature/*": [
        "./pm-type-feature/src/*"
      ],
      "pm-type-bug": [
        "./pm-type-bug/src/index.ts"
      ],
      "pm-type-bug/*": [
        "./pm-type-bug/src/*"
      ],
      "pm-type-doc": [
        "./pm-type-doc/src/index.ts"
      ],
      "pm-type-doc/*": [
        "./pm-type-doc/src/*"
      ],
      "pm-type-refactor": [
        "./pm-type-refactor/src/index.ts"
      ],
      "pm-type-refactor/*": [
        "./pm-type-refactor/src/*"
      ],
      "pm-type-spike": [
        "./pm-type-spike/src/index.ts"
      ],
      "pm-type-spike/*": [
        "./pm-type-spike/src/*"
      ],
      "pm-type-chore": [
        "./pm-type-chore/src/index.ts"
      ],
      "pm-type-chore/*": [
        "./pm-type-chore/src/*"
      ],
      "tool-pm": [
        "./tool-pm/src/index.ts"
      ],
      "tool-pm/*": [
        "./tool-pm/src/*"
      ],
      "pm-round-driver": [
        "./pm-round-driver/src/index.ts"
      ],
      "pm-round-driver/*": [
        "./pm-round-driver/src/*"
      ],
      "pm-workflow": [
        "./pm-workflow/src/index.ts"
      ],
      "pm-workflow/*": [
        "./pm-workflow/src/*"
      ],
      "pm-client": [
        "./pm-client/src/index.ts"
      ],
      "pm-client/*": [
        "./pm-client/src/*"
      ],
      "command-pm": [
        "./command-pm/src/index.ts"
      ],
      "command-pm/*": [
        "./command-pm/src/*"
      ],
      "pm-templates": [
        "./pm-templates"
      ],
      "pm-skills": [
        "./pm-skills"
      ],
      "pm-eval-suite": [
        "./pm-eval-suite"
      ],
      "pm-scripts": [
        "./pm-scripts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "pm/*/src/**/*.ts",
    "pm/*/tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib"
  ]
}
